apiVersion: v1beta1
kind: AgentConfig
metadata:
  name: {{ cluster.name }}
rendezvousIP: {{ cluster.rendezvous_ip }}
hosts:
{% for host in nodes %}
- hostname: {{ host.name }}
  role: {{ host.role }}
  interfaces:
  - name: {{ host.interface }}
    macAddress: {{ host.mac }}
  networkConfig:
    interfaces:
    - name: {{ host.interface }}
      type: ethernet
      state: up
      mac-address: {{ host.mac }}
      ipv4:
        enabled: true
        dhcp: false
        address:
        - ip: {{ host.ip }}
          prefix-length: {{ host.prefix_length }}
    dns-resolver:
      config:
        server:
{% for server in host.dns_servers | default(network.dns_servers) %}
        - {{ server }}
{% endfor %}
    routes:
      config:
      - destination: 0.0.0.0/0
        next-hop-address: {{ host.gateway | default(network.gateway) }}
        next-hop-interface: {{ host.interface }}
        table-id: 254
{% if host.root_device_hint | default('') %}
  rootDeviceHints:
    deviceName: {{ host.root_device_hint }}
{% endif %}
{% endfor %}
